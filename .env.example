APP_NAME="Farmer Procurement System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_SECRET=your-random-secret-key-change-this
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=farmer_procurement
DB_USERNAME=db_user
DB_PASSWORD=db_pass
DB_CHARSET=utf8mb4

JWT_SECRET=your-jwt-secret-key-change-this
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

SESSION_LIFETIME=1800
REMEMBER_ME_EXPIRY=2592000

OTP_EXPIRY=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# AES-256-GCM master key for encrypted system secrets.
# Must be exactly 64 hexadecimal characters (256-bit). Never commit the real value.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=your-256-bit-encryption-key-change-this

RATE_LIMIT_LOGIN=5
RATE_LIMIT_OTP=3
RATE_LIMIT_BOOKING=10
RATE_LIMIT_SMS=10
RATE_LIMIT_API=60

CORS_ALLOWED_ORIGINS=*

DEFAULT_LOCALE=en
ALLOWED_MIME_TYPES=jpg,png,webp,pdf,csv,xlsx
FILE_UPLOAD_MAX_SIZE=5242880

PERMISSION_NEGATIVE_PRIORITY=true
SUPER_ADMIN_ROLE_ID=1

NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_INTERVAL=300

PUSH_IMMEDIATE=true
PUSH_RETRY_MAX=3
PUSH_BACKOFF_BASE=60
PUSH_BACKOFF_CAP=1800
PUSH_DEDUP_WINDOW=3600
ONESIGNAL_TIMEOUT=10

ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
OTP_API_KEY=your-otp-gateway-api-key
OTP_SENDER_ID=FPS
OTP_TEMPLATE_ID=your-otp-template-id
