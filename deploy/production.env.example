# ===========================================================================
# PRODUCTION ENVIRONMENT TEMPLATE  (deploy/production.env.example)
# ---------------------------------------------------------------------------
# Copy this file to the production server OUTSIDE the public webroot as `.env`
# and fill in real values. NEVER commit the real .env. This file only documents
# which keys production must set.
#
#   cp deploy/production.env.example <host>/<app-root>/.env
#   chmod 600 .env
#
# Production rules enforced by the application:
#   - APP_ENV=production  -> all /api/v1/test/* and /web/test/mutate routes are
#                            removed at route-registration time (config/routes.php)
#   - APP_DEBUG=false     -> every error response is the safe envelope
#                            { "success": false, "error": { "code", "message" } }
#                            with full details written to storage/logs only.
#   - /health and /health/maintenance remain public.
#   - CORS allowed origins must be explicit, never '*', in production.
# ===========================================================================

# --- App ----------------------------------------------------------------
APP_NAME="Farmer Procurement System"
APP_ENV=production
APP_DEBUG=false
# Production origin, must be https once SSL is installed.
APP_URL=https://your-domain.example
# Replace with a long random string (openssl rand -hex 32)
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Kolkata

# --- Database (create dedicated MySQL user with SELECT/INSERT/UPDATE/DELETE
#     on the app DB; full rights only for migrations if separate account used) --
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_DB_NAME
DB_USERNAME=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_CHARSET=utf8mb4

# --- Auth / sessions ----------------------------------------------------
# Replace with long random values. JWT_SECRET rotate on compromise only.
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

SESSION_LIFETIME=1800
REMEMBER_ME_EXPIRY=2592000

# --- OTP ------------------------------------------------------------------
OTP_EXPIRY=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# --- Secrets encryption -----------------------------------------------------
# Must be exactly 64 hexadecimal chars (256-bit AES-256-GCM master key).
# Generate: php -r "echo bin2hex(random_bytes(32));"
# STORE THIS SEPARATELY (password manager / offline vault). It cannot be
# recovered; if lost, all encrypted system secrets are unrecoverable.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_LOGIN=5
RATE_LIMIT_OTP=3
RATE_LIMIT_BOOKING=10
RATE_LIMIT_SMS=10
RATE_LIMIT_API=60

# --- CORS: explicit production origins (comma-separated), NEITHER '*' NOR empty
# Portal is same-origin (apiBase ''), so only needed for the Flutter app host
# or any separate origin that calls the API directly.
CORS_ALLOWED_ORIGINS=https://your-domain.example

# --- Localization / files -----------------------------------------------------
DEFAULT_LOCALE=en
ALLOWED_MIME_TYPES=jpg,png,webp,pdf,csv,xlsx
FILE_UPLOAD_MAX_SIZE=5242880

# --- RBAC ---------------------------------------------------------------------
PERMISSION_NEGATIVE_PRIORITY=true
SUPER_ADMIN_ROLE_ID=1

# --- Notification retry --------------------------------------------------------
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_INTERVAL=300

# --- Push (OneSignal LIVE keys — separate OneSignal app for production) -----
# LIVE app id + REST key go ONLY into the production .env. Keep the staging
# app id out of this file so prod and staging apps stay isolated.
PUSH_IMMEDIATE=true
PUSH_RETRY_MAX=3
PUSH_BACKOFF_BASE=60
PUSH_BACKOFF_CAP=1800
PUSH_DEDUP_WINDOW=3600
ONESIGNAL_TIMEOUT=10
ONESIGNAL_APP_ID=REPLACE_WITH_LIVE_ONESIGNAL_APP_ID
ONESIGNAL_REST_API_KEY=REPLACE_WITH_LIVE_ONESIGNAL_REST_API_KEY

# --- OTP gateway (LIVE production credentials) --------------------------------
OTP_API_KEY=REPLACE_WITH_LIVE_OTP_API_KEY
OTP_SENDER_ID=REPLACE_SENDER_ID
OTP_TEMPLATE_ID=REPLACE_LIVE_OTP_TEMPLATE_ID