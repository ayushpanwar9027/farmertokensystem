# ============================================================================
# .htaccess (repo root) - DEFENCE-IN-DEPTH for the Option-B APP ROOT
# /home/<user>/testing.deepjyotimicrofinance.com/  (OUTSIDE the webroot).
#
# The webroot is <sub>/public_html/, so this file is normally NEVER evaluated
# by Apache. It exists ONLY so that .env / app/ / storage/ / logs stay denied
# IF the parent directory is ever served by mistake (mis-pointed docroot,
# symlink, host quirk). The real production ruleset lives in
# deploy/htaccess.production  <->  public/.htaccess.
# ============================================================================

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # If this root ever serves a docroot, refuse everything except public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/favicon\.ico$
    RewriteRule ^ - [F,L]

    # Direct hits into non-public dirs / secrets / logs
    RewriteRule ^\.(env|env\.example|env\.production|gitignore)$ - [F,L]
    RewriteRule ^\.git(?:/|$) - [F,L]
    RewriteRule .*\.(?:log|sql|ini|sh|bak|swp)$ - [F,L]
    RewriteRule ^(?:app|config|database|storage|resources|scripts)(?:/|$) - [F,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<FilesMatch "^\.(env|env\.example|env\.production|gitignore|htpasswd|user\.ini)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(log|sql|ini|sh|bak|swp)$">
    Require all denied
</FilesMatch>